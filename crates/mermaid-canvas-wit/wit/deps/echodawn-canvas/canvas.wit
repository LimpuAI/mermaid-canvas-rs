package echodawn:canvas@1.0.0;

interface draw {
    // ---- Tier 2 参数动画（宿主本地插值，零 wasm 调用）----
    enum anim-property { opacity }
    enum loop-mode { once, loop, ping-pong }
    record keyframe { t: f32, value: f32, easing: string }
    record anim-desc {
        property: anim-property,
        keyframes: list<keyframe>,
        duration-ms: u32,
        delay-ms: u32,
        loop: loop-mode,
    }

    // ---- 无损绘制描述（与 deneb v2 现状逐字段一致）----
    record font-desc { family: option<string>, weight: option<u16>, italic: bool }
    record gradient-stop { pos: f64, color: string }
    record linear-gradient { x0: f64, y0: f64, x1: f64, y1: f64, stops: list<gradient-stop> }
    variant paint { solid(string), gradient(linear-gradient) }
    record draw-cmd {
        cmd-type: string,        // "rect" | "path" | "circle" | "arc" | "text"
        params: list<f64>,       // 与 deneb v2 语义逐字段一致；baseline 1=Middle/2=Bottom 按整块布局盒换算（多行 \n 块级锚定，宿主 translate 是唯一换算防线）
        fill: option<paint>,
        stroke: option<paint>,
        stroke-width: option<f64>,
        corner-radius: option<f64>,
        text-content: option<string>,
        font: option<font-desc>,
        group-depth: u32,
        anim: option<anim-desc>,
    }
    record layer { kind: string, dirty: bool, z-index: u32, commands: list<draw-cmd> }
}
